{
  "name": "fitplan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "description": "Bitacora personal de entrenamiento y composicion corporal. PWA local-first, sin backend.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:ui": "node test/ui-harness.mjs",
    "check:occlusion": "node test/occlusion.mjs",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/features/sync/api/schema.d.ts"
  },
  "dependencies": {
    "@clerk/react": "^6.18.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
