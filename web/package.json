{
  "name": "fitplan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "description": "Bitacora personal de entrenamiento y composicion corporal. PWA local-first, sin backend.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:ui": "node test/ui-harness.mjs",
    "check:occlusion": "node test/occlusion.mjs",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/features/sync/api/schema.d.ts"
  },
  "dependencies": {
    "@clerk/react": "^6.18.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.4"
  }
}
